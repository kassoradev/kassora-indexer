# Which chain to index: 4663 (Robinhood Chain mainnet), 46630 (testnet) or 31337 (local anvil).
CHAIN_ID=4663

# RPC URL for the selected chain. Only the one matching CHAIN_ID is required.
PONDER_RPC_URL_4663=https://rpc.mainnet.chain.robinhood.com
# Testnet RPC is not published here on purpose: set it from the official Robinhood Chain docs.
PONDER_RPC_URL_46630=
PONDER_RPC_URL_31337=http://127.0.0.1:8560

# KassoraVault address(es). Comma-separate to index several vaults on the same chain.
VAULT_ADDRESS=
# Block to start indexing from (the vault deployment block; see deployments/<chainId>.json in kassora-contracts).
VAULT_START_BLOCK=0

# Read vault state every N blocks for the share-price / TVL series. Tune to the chain's block time.
SNAPSHOT_INTERVAL_BLOCKS=3600

# Optional. Postgres connection string; when unset Ponder uses an embedded PGlite in .ponder/.
# DATABASE_URL=postgres://user:pass@host:5432/kassora
# Required by `ponder start` (or pass --schema). Use a new schema per deployment.
# DATABASE_SCHEMA=kassora_v1

# Optional. RPC polling interval in ms (default 1000).
# PONDER_POLLING_INTERVAL_MS=1000
